<Window x:Class="SolderStation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SolderStation.Behaviors"
        Title="T12 Station — паяльная станция"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Language="ru-RU"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">

    <DockPanel>

        <!-- ================= header: connection ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,4">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Тёмная тема"
                          IsChecked="{Binding IsDarkTheme}" VerticalAlignment="Center" Margin="0,0,0,6"/>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="T12 Station" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>

                    <ComboBox Width="290" Margin="0,0,6,6" ItemsSource="{Binding Ports}"
                              SelectedItem="{Binding SelectedPort}" DisplayMemberPath="Display"
                              IsEnabled="{Binding IsDisconnected}" ToolTip="COM-порт станции (USB или UART)"/>
                    <Button Content="⟳" Padding="10,5" ToolTip="Обновить список портов"
                            Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding IsDisconnected}"/>
                    <ComboBox Width="95" Margin="0,0,6,6" ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding BaudRate}" IsEnabled="{Binding IsDisconnected}"
                              ToolTip="Скорость UART. Для USB-порта значения не имеет"/>

                    <Button Style="{StaticResource AccentButton}" Content="Подключить" Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Отключить" Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Найти станцию" Command="{Binding AutoFindCommand}"
                            ToolTip="Опросить все порты командой PING"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,6">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SubTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Text="{Binding Firmware, StringFormat=прошивка {0}}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="нет связи"
                                   Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ================= status bar ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="90" Height="6" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ================= body ================= -->
        <Grid Margin="14,12,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ live panel ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0"
                          IsEnabled="{Binding IsConnected}">
                <StackPanel>

                    <!-- temperature -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Температура жала" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TipTemp, StringFormat={}{0:0}}" FontSize="64" FontWeight="Light"
                                           Visibility="{Binding NoTip, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <TextBlock Text="— —" FontSize="64" FontWeight="Light" Foreground="{DynamicResource SubTextBrush}"
                                           Visibility="{Binding NoTip, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="°C" FontSize="22" Margin="6,14,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ModeText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}">
                                <Run Text="Уставка"/> <Run Text="{Binding DeviceSetpoint, Mode=OneWay}"/><Run Text=" °C · цель"/>
                                <Run Text="{Binding Target, Mode=OneWay}"/><Run Text=" °C"/>
                            </TextBlock>

                            <ProgressBar Maximum="100" Value="{Binding Duty, Mode=OneWay}" Margin="0,10,0,4"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Power, StringFormat=Мощность {0:0.0} Вт}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Vin, StringFormat=Питание {0:0.0} В}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}"
                                           Text="{Binding ColdJunction, StringFormat=Хол. спай {0:0.0} °C}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}"
                                           Text="{Binding McuTemp, StringFormat=МК {0:0.0} °C}"/>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Сбросить" Margin="6,0,0,0"
                                            Command="{Binding ClearErrorsCommand}"/>
                                    <TextBlock Text="{Binding ErrorText, StringFormat=Ошибка: {0}}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- mode -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Режим" Style="{StaticResource Header}"/>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource ModeButton}" Content="Выкл"
                                        Command="{Binding SetModeCommand}" CommandParameter="OFF"/>
                                <Button Style="{StaticResource AccentButton}" MinHeight="38" FontWeight="SemiBold"
                                        Margin="0,0,6,6" Content="Нагрев"
                                        Command="{Binding SetModeCommand}" CommandParameter="RUN"/>
                                <Button Style="{StaticResource ModeButton}" Content="Буст"
                                        Command="{Binding SetModeCommand}" CommandParameter="BOOST"/>
                                <Button Style="{StaticResource ModeButton}" Content="Сон"
                                        Command="{Binding SetModeCommand}" CommandParameter="SLEEP"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- setpoint -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Уставка температуры" Style="{StaticResource Header}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="−10" Width="46" Margin="0,0,4,0"
                                        Command="{Binding ChangeSetpointCommand}" CommandParameter="-10"/>
                                <Button DockPanel.Dock="Left" Content="−1" Width="38" Margin="0,0,6,0"
                                        Command="{Binding ChangeSetpointCommand}" CommandParameter="-1"/>
                                <Button DockPanel.Dock="Right" Content="+10" Width="46" Margin="4,0,0,0"
                                        Command="{Binding ChangeSetpointCommand}" CommandParameter="10"/>
                                <Button DockPanel.Dock="Right" Content="+1" Width="38" Margin="6,0,0,0"
                                        Command="{Binding ChangeSetpointCommand}" CommandParameter="1"/>
                                <TextBox Text="{Binding Setpoint, UpdateSourceTrigger=LostFocus}" FontSize="22"
                                         HorizontalContentAlignment="Center" MinWidth="70"/>
                            </DockPanel>
                            <Slider Margin="0,10,0,6" Minimum="{Binding SetpointMin}" Maximum="{Binding SetpointMax}"
                                    Value="{Binding Setpoint}" SmallChange="1" LargeChange="10"
                                    TickFrequency="5" IsSnapToTickEnabled="True"/>

                            <TextBlock Text="Быстрый выбор (правый клик — удалить)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" MinWidth="54"
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Удалить из быстрого выбора"
                                                              Command="{Binding RemovePresetCommand}"
                                                              CommandParameter="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Запомнить текущую уставку" HorizontalAlignment="Left"
                                    Command="{Binding AddPresetCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- active tip -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Активное жало" Style="{StaticResource Header}"/>
                            <ComboBox ItemsSource="{Binding Tips}" DisplayMemberPath="Name"
                                      SelectedIndex="{Binding ActiveTipIndex}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ tabs ============ -->
            <TabControl Grid.Column="1">

                <!-- ===== settings ===== -->
                <TabItem Header="Настройки">
                    <DockPanel IsEnabled="{Binding IsConnected}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Сохранить во флеш"
                                    Command="{Binding SaveToFlashCommand}"
                                    ToolTip="Изменения применяются сразу и сохраняются станцией автоматически через 4 с. Кнопка сохраняет немедленно"/>
                            <Button Content="Перечитать" Command="{Binding ReloadParamsCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="Заводские настройки…"
                                    Command="{Binding FactoryDefaultsCommand}"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding ParamGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Header}"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="250"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"/>
                                                                </StackPanel>

                                                                <!-- number: slider + text box -->
                                                                <Slider Grid.Column="1" VerticalAlignment="Center"
                                                                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                        SmallChange="{Binding SmallStep}" LargeChange="{Binding LargeStep}"
                                                                        TickFrequency="{Binding SmallStep}" IsSnapToTickEnabled="True"
                                                                        Value="{Binding Value}"
                                                                        Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}"/>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                                                            Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBox Width="70" HorizontalContentAlignment="Right"
                                                                             Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Text="{Binding Unit}" Width="56" Margin="6,0,0,0"
                                                                               VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                                </StackPanel>

                                                                <!-- on / off -->
                                                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                                                          IsChecked="{Binding BoolValue}" VerticalAlignment="Center"
                                                                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}"/>

                                                                <!-- choice -->
                                                                <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                                                          ItemsSource="{Binding Options}" SelectedIndex="{Binding ChoiceIndex}"
                                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"/>

                                                                <!-- "sending" marker -->
                                                                <Ellipse Grid.Column="0" Width="6" Height="6" HorizontalAlignment="Left"
                                                                         VerticalAlignment="Top" Margin="-10,6,0,0"
                                                                         Fill="{DynamicResource AccentBrush}"
                                                                         Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ===== tips ===== -->
                <TabItem Header="Жала">
                    <Grid IsEnabled="{Binding IsConnected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}">
                                    <Run Text="Профили жал"/>
                                    <Run Text="{Binding Tips.Count, Mode=OneWay}" Foreground="{DynamicResource SubTextBrush}"/><Run Text="/" Foreground="{DynamicResource SubTextBrush}"/><Run Text="{Binding MaxTips, Mode=OneWay}" Foreground="{DynamicResource SubTextBrush}"/>
                                </TextBlock>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Добавить" Command="{Binding AddTipCommand}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Удалить" Command="{Binding DeleteTipCommand}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Tips}" SelectedItem="{Binding SelectedTip}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource WarningBrush}"
                                                           ToolTip="Есть несохранённые изменения"
                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding SelectedTip, Converter={StaticResource NotNull}}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Профиль" Style="{StaticResource Header}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Имя" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" MaxLength="8" CharacterCasing="Upper"
                                                     Text="{Binding SelectedTip.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Caption}" Text="до 8 символов: A-Z 0-9 - _ . + / #"/>

                                            <TextBlock Grid.Row="1" Text="Уставка, °C" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTip.Setpoint, UpdateSourceTrigger=LostFocus}"/>

                                            <TextBlock Grid.Row="2" Text="PID Kp" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTip.Kp, StringFormat=0.000, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Caption}" Text="доля мощности на 1 °C ошибки"/>

                                            <TextBlock Grid.Row="3" Text="PID Ki" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTip.Ki, StringFormat=0.000, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Caption}" Text="1/(°C·с) — убирает статическую ошибку"/>

                                            <TextBlock Grid.Row="4" Text="PID Kd" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTip.Kd, StringFormat=0.000, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Caption}" Text="с/°C — гасит перерегулирование"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Калибровка" Style="{StaticResource Header}"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Код АЦП термопары и разница «жало − холодный спай» в трёх точках. Обычно заполняется мастером калибровки."/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="1" Text="Точка 1" Style="{StaticResource Caption}"/>
                                            <TextBlock Grid.Column="2" Text="Точка 2" Style="{StaticResource Caption}"/>
                                            <TextBlock Grid.Column="3" Text="Точка 3" Style="{StaticResource Caption}"/>
                                            <TextBlock Grid.Row="1" Text="Код АЦП" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" Text="{Binding SelectedTip.Adc1, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,4" Text="{Binding SelectedTip.Adc2, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,4" Text="{Binding SelectedTip.Adc3, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="2" Text="ΔT, °C" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,4" Text="{Binding SelectedTip.Dt1, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,8,4" Text="{Binding SelectedTip.Dt2, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,8,4" Text="{Binding SelectedTip.Dt3, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <WrapPanel>
                                    <Button Style="{StaticResource AccentButton}" Content="Записать в станцию" Command="{Binding ApplyTipCommand}"/>
                                    <Button Content="Отменить изменения" Command="{Binding RevertTipCommand}"/>
                                    <Button Content="Сделать активным" Command="{Binding ActivateTipCommand}"/>
                                    <Button Content="Калибровка…" Command="{Binding CalibrateTipCommand}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Сбросить калибровку"
                                            Command="{Binding ResetTipCalibrationCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ===== service ===== -->
                <TabItem Header="Сервис">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                                <StackPanel>
                                    <TextBlock Text="Часы станции" Style="{StaticResource Header}"/>
                                    <TextBlock Text="{Binding DeviceTime}" FontSize="22" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Прочитать" Command="{Binding ReadTimeCommand}"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Синхронизировать с компьютером"
                                                Command="{Binding SyncTimeCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Импорт и экспорт настроек" Style="{StaticResource Header}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="Файл JSON со всеми параметрами и профилями жал (калибровка, PID, уставки). Подходит для переноса на другую станцию и резервного копирования."/>
                                    <WrapPanel IsEnabled="{Binding IsConnected}">
                                        <Button Content="Экспорт в файл…" Command="{Binding ExportCommand}"/>
                                        <Button Content="Импорт из файла…" Command="{Binding ImportCommand}"/>
                                        <Button Content="Восстановить из резервной копии…" Command="{Binding RestoreBackupCommand}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoBackup}"
                                                  Content="Резервная копия при каждом подключении" Margin="0,0,16,6"/>
                                        <Button Content="Открыть папку копий" Command="{Binding OpenBackupFolderCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Подключение" Style="{StaticResource Header}"/>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoReconnect}"
                                              Content="Переподключаться автоматически при обрыве связи"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                                <StackPanel>
                                    <TextBlock Text="Устройство" Style="{StaticResource Header}"/>
                                    <TextBlock Text="{Binding DeviceDetails}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                               Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Звуковой сигнал" Command="{Binding BeepCommand}"
                                                ToolTip="Помогает найти нужную станцию, если их несколько"/>
                                        <Button Content="Перезагрузить" Command="{Binding RebootDeviceCommand}"/>
                                        <Button Style="{StaticResource DangerButton}" Content="Режим обновления прошивки (DFU)…"
                                                Command="{Binding EnterBootloaderCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== console ===== -->
                <TabItem Header="Консоль">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearConsoleCommand}"/>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Поток !S"
                                      IsChecked="{Binding ConsoleShowStream}" Margin="6,0,12,6" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Отправить"
                                    Command="{Binding SendConsoleCommand}" IsEnabled="{Binding IsConnected}"/>
                            <TextBox Margin="0,0,6,6" FontFamily="Consolas" IsEnabled="{Binding IsConnected}"
                                     Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Команда протокола, например HELP, STATUS, GET temp_max">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendConsoleCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Border Background="{DynamicResource ConsoleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6">
                            <ListBox ItemsSource="{Binding ConsoleLines}" FontFamily="Consolas" FontSize="12"
                                     ItemContainerStyle="{StaticResource ConsoleItem}"
                                     b:AutoScroll.Enabled="True"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>

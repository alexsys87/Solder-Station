<!-- Dark color theme. Every brush key must also exist in Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#16181C"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1F2228"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E323A"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#1B1E23"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9AA1AD"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#272B32"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3F48"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#30353D"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3A4049"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#4A2A17"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F76707"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FD7E14"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#51CF66"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCC419"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#4DABF7"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#30353D"/>
    <SolidColorBrush x:Key="ConsoleBrush" Color="#121418"/>
</ResourceDictionary>

<!-- Light color theme. Every brush key must also exist in Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DFE2E7"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1E2228"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C5CAD3"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#ECEEF2"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#DFE2E8"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#FFE9DA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8590C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F76707"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E03131"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E44"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F08C00"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#1C7ED6"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="ConsoleBrush" Color="#FAFAFB"/>
</ResourceDictionary>
